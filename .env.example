# MongoDB connection string.
# Get one free at https://www.mongodb.com/cloud/atlas
# Copy this file to `.env` and fill in your value.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reoweek?retryWrites=true&w=majority"

# Password for the /admin analytics page (sent as an x-admin-password header).
# If unset, admin endpoints stay locked. Also set this in Vercel project settings.
ADMIN_PASSWORD="pick-a-strong-password"

# Set to "false" to remove the clear-all-data option from /admin
# (also enforced server-side). Anything else (or unset) leaves it enabled.
ENABLE_DELETE="true"
